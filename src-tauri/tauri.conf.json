{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todojam",
  "version": "0.1.0",
  "identifier": "app.todojam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Todojam",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNEI1NzVBRDI4MDhDQjQKUldTMGpJRFNXbGRMZ0pFSWY4ZEd0aVpESXBoK3dEL2NLb1d4cmwvU1NzMXc3TmRXZUkvL3hiOGEK",
      "endpoints": [
        "https://github.com/jasonxmartinez/taskjam/releases/download/latest-mac/latest.json"
      ]
    }
  }
}
